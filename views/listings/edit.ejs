<% layout("/layouts/boilerplate")%>
<body>
    <h3>Edit the details</h3>

    <form method="POST" action="/listing/<%=listing._id%>?_method=PUT">
        <input type="text" value="<%=listing.title%>" name="title">
        <br><br>
        <textarea name="description" type="text" ><%=listing.description%></textarea>
        <br><br>
        <input type="number" value="<%=listing.price%>" name="price">
        <br><br>
        <input type="text" value="<%=listing.location%>" name="location">
        <br><br>
        <input type="text" value="<%=listing.country%>" name="country">
        <br><br>
        <button>Submit</button>
    </form>
</body>
