<% layout("/layouts/boilerplate")%>

    <body>
        <br><br>
        <div class="row">
            <div class="col-8 offset-2">
                <form method="POST" action="/listings">

                    <div class="mb-3">
                        <label for="title" class="form-label new-label"><b>Title</b></label>
                        <input type="string" name="title" placeholder="Add a catchy title" class="form-control">
                    </div>


                    <div class="mb-3">
                        <label for="description" class="form-label new-label"><b>Description</b></label>
                        <textarea type="text" name="description" class="form-control"></textarea>
                    </div>


                    <div class="mb-3">
                        <label for="image" class="form-label new-label"><b>Image</b></label>
                        <input type="text" name="image" placeholder="Provide image" class="form-control">
                    </div>

                    <div class="row">
                        <div class="mb-3 col-md-4">
                            <label for="price" class="form-label new-label"><b>Price</b></label>
                            <input type="number" name="price" placeholder="2400" class="form-control">
                        </div>


                        <div class="mb-3 col-md-8">
                            <label for="country" class="form-label new-label"><b>Country</b></label>
                            <input type="text" name="country" placeholder="India" class="form-control">
                        </div>
                    </div>



                    <div class="mb-3">
                        <label for="location" class="form-label new-label"><b>Location</b></label>
                        <input type="text" name="location" placeholder="Chittorgarh,Rajasthan" class="form-control">
                    </div>
                    <br>

                    <button class="btn btn-dark add-btn">Submit</button>
                    <br><br>
                </form>
            </div>
        </div>
    </body>