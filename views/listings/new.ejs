<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>
<body>
    <form method="POST" action="/listings">
        <input type="string" name="title" placeholder="enter the title">
        <br><br>
        <textarea type="text" name="description" placeholder="enter the description"></textarea>
        <br><br>
        <input type="text" name="image" placeholder="enter the image">
        <br><br>
        <input type="number" name="price" placeholder="enter the price">
        <br><br>
        <input type="text" name="country" placeholder="enter the country">
        <br><br>
        <input type="text" name="location" placeholder="enter the location">
        <br><br>
        <button>Submit</button>
    </form>
</body>
</html>